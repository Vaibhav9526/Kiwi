{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KIWI",
  "version": "0.1.0",
  "identifier": "com.kiwi.mail",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KIWI",
        "width": 1280,
        "height": 820,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica", "acrylic", "blur"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "KIWI contributors",
    "copyright": "Copyright \u00c2\u00a9 2026 KIWI contributors",
    "shortDescription": "KIWI \u00e2\u20ac\u201d local-first security-first mail client (alpha)",
    "longDescription": "KIWI is a standalone, local-first desktop mail client with deterministic TLS, transport, and authentication analysis. Alpha build \u00e2\u20ac\u201d unsigned, no auto-update.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}