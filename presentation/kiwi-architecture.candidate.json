  "cards": [
    { "dot": "cyan", "title": "Mail pipeline", "items": [
      "Inbound: IMAP IDLE/poll or POP3 UIDL → TLS capture → MIME → SQLite+FTS5 → risk/auth stamps → rules",
      "Outbound: compose → enqueue (undo window) → outbox → SMTP wire → IMAP \\Sent append → audit"
    ] },
    { "dot": "rose", "title": "Security spine", "items": [
      "TlsObservation per connection: TLS version, cipher, forward secrecy, STARTTLS",
      "Deterministic findings only — AI explains, never asserts",
      "Trust engine + PairEngine drive a native lock enforced at IPC",
      "Link gate verdicts: allow | confirm | sandbox | deny — risky opens in WSL2 guest"
    ] },
    { "dot": "emerald", "title": "Boundaries", "items": [
      "Every kiwi_* command validates input and runs the lock gate",
      "External sends require a native consent dialog — renderer cannot reach out alone",
      "audit.jsonl corruption surfaces as audit-corrupt, never hidden",
      "Secrets live in the OS credential store — never persisted or logged",
      "unsafe_code forbidden across the whole workspace",
      "kiwi-integrations reaches external APIs only via a consented, bounded client"
    ] },
    { "dot": "violet", "title": "Also in the workspace", "items": [
      "kiwi-autoconfig — ISPDB/MX account discovery + OAuth2 (kiwi-autoconfig/src/lib.rs)",
      "kiwi-contacts — vCard address book (kiwi-contacts/src/lib.rs)"
    ] }
  ]
