# KIWI local infrastructure — copy to `.env` and adjust. NEVER commit `.env`
# (real secrets live there eventually). This example holds dev defaults only.

# --- PostgreSQL (compose service `db`) ---
POSTGRES_USER=kiwi
POSTGRES_PASSWORD=kiwi-dev-only-change-me
POSTGRES_DB=kiwi_admin
POSTGRES_PORT=5432

# --- kiwi-admin service ---
KIWI_ADMIN_PORT=3001
# Service DSN inside the compose network (hostname `db`); host tools use
# localhost:${POSTGRES_PORT}. The password here is a DEV default — override
# in `.env` (gitignored) for anything beyond local development.
DATABASE_URL=postgresql://kiwi:kiwi-dev-only-change-me@db:5432/kiwi_admin
DATABASE_URL_HOST=postgresql://kiwi:kiwi-dev-only-change-me@localhost:5432/kiwi_admin

# Signing key for the audit export (`GET /api/v1/audit/export`, T-179). This is
# a DEV default and is NOT a secret — override it in `.env` (gitignored) for
# anything beyond local development. The key is never logged and never appears
# in the export; the artifact carries only its SHA-256 fingerprint (`key_id`).
# Unset or blank means exports are UNSIGNED, and the export says so
# (`signed: false`) rather than emitting a placeholder signature.
KIWI_AUDIT_EXPORT_KEY=kiwi-dev-only-audit-export-key-change-me

# --- mailpit (dev/test mail server: SMTP+POP3+API/UI — NO IMAP, see T-147) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_POP3_PORT=1100
MAILPIT_UI_PORT=8025

# --- greenmail (dev/test IMAP server for live sync tests) ---
GREENMAIL_IMAP_PORT=1143
